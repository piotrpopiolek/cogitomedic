# W produkcji (ENVIRONMENT=prod) SECRET_KEY jest wymagany – aplikacja nie uruchomi się bez niego.
SECRET_KEY=change-me-in-local-env
# Lokalnie DEBUG=1 (domyślnie włączone poza ENVIRONMENT=prod). W produkcji DEBUG jest zawsze wyłączone.
DEBUG=1
# Lokalnie zostaw puste — Sentry inicjuje się tylko gdy ENVIRONMENT != dev i DSN jest ustawiony.
SENTRY_DSN=
# Performance (traces): domyślnie 50% requestów biznesowych; /api/v1/observability/* ma rate 0 (Prometheus scrape).
SENTRY_TRACES_SAMPLE_RATE=0.5
DB_NAME=cogitomedica
DB_USER=cogito_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# W produkcji ALLOWED_HOSTS musi być ustawione (np. twojadomena.com). Domyślnie puste.
# Dla Docker Compose: dodaj "web", żeby Prometheus mógł scrapować metryki (Host: web:8000).
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Nginx z TLS: na produkcji MUSI być 1 — inaczej Django nie ustawia request.is_secure() i SECURE_SSL_REDIRECT
# zapętla 301 (ten sam URL HTTPS). Lokalnie / bez zaufanego proxy zostaw 0.
USE_TRUSTED_REVERSE_PROXY=0
# Gdy prod jeszcze tylko po HTTP (np. przed certyfikatem), wyłącz przekierowanie na HTTPS:
# SECURE_SSL_REDIRECT=0
DJANGO_TIME_ZONE=Europe/Warsaw

# Opcjonalnie: dozwolone origins dla CORS (gdy front na innej domenie/porcie).
# W dev bez tej zmiennej używane są localhost:8000, 127.0.0.1:8000, localhost:3000, 127.0.0.1:3000.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Token autoryzacyjny dla endpointu Prometheusa (np. dla /api/v1/observability/metrics)
PROMETHEUS_METRICS_TOKEN=change-me-in-local-env

# Webhooki Alertmanagera (renderowane przy starcie kontenera z deploy/prometheus/*.yml.template).
# Jak podłączyć Slack / Discord / test (webhook.site): docs/observability-setup.md.
# Discord: ustaw 1 — używany jest szablon z discord_configs (nie surowy webhook JSON).
# ALERTMANAGER_USE_DISCORD=1
# ALERTMANAGER_WEBHOOK_URL=https://discord.com/api/webhooks/.../...
# Domyślny URL dla wszystkich ścieżek + fallback (Slack / webhook.site / Discord — zależnie od trybu):
# ALERTMANAGER_WEBHOOK_URL=https://hooks.slack.com/services/...
# Opcjonalnie osobne kanały (routing po severity: critical vs warning) — Slack, Discord lub inny URL:
# ALERTMANAGER_WEBHOOK_CRITICAL_URL=...
# ALERTMANAGER_WEBHOOK_WARNING_URL=...
# Uwaga: znaki # i | w URL mogą psować sed (separator #) — wtedy inny mechanizm podstawiania lub URL bez tych znaków.

# SMS (SMSApi smsapi.pl) – portal ergebnisse, outbox SMS_SEND
# Supported regions: SUPPORTED_SMS_REGIONS in apps/reception/phone_utils.py (incl. GB +44).
# UK routing must be enabled on your SMSAPI account before production use.
SMSAPI_ACCESS_TOKEN=
SMSAPI_USE_MOCK=0

# Retencja lokalnych PDF (portal ergebnisse, outbox) — po tylu dniach od publikacji plik
# jest usuwany z MEDIA_ROOT, gdy hidrive_sent && sms_sent (kopia na HiDrive + SMS wysłany).
# Domyślnie 60 dni okna pobrania przez pacjenta; na VPS uwzględnij większe zużycie dysku.
PDF_RETENTION_DAYS=60

# Outbox / intake-outbox: max automatic retries before DEAD_LETTER (default 3; was 10).
OUTBOX_MAX_RETRIES=3

# Domyślny rozmiar strony list (10, 20, 50 lub 100). Bez wpisu: 50.
# LIST_PAGE_SIZE_DEFAULT=50

# HiDrive (Strato) – outbox upload PDF
# 1 = no HTTP; pliki nie pojawią się w chmurze (tylko testy / dev bez OAuth). 0 = prawdziwe API (wymaga OAuth poniżej).
HIDRIVE_USE_MOCK=0
HIDRIVE_CLIENT_ID=
HIDRIVE_CLIENT_SECRET=
HIDRIVE_REFRESH_TOKEN=
# Optional override endpoints/timeouts:
# HIDRIVE_TOKEN_URL=https://my.hidrive.com/oauth2/token
# HIDRIVE_API_BASE_URL=https://api.hidrive.strato.com/2.1
# HIDRIVE_TIMEOUT_SECONDS=30
# HiDrive path resolution:
# - Paths starting with /public/ target the root-level Common (shared) space directly.
# - Paths starting with /users/ are absolute — used as-is.
# - Other paths get /users/<OAuth-alias>/ prepended (personal space).
#
# Common (shared) space (recommended for team use):
# HIDRIVE_INCOMING_PATH=/public/incoming
# HIDRIVE_PROCESSED_PATH=/public/processed
# HIDRIVE_PATIENTS_DIR_PREFIX=/public/patients
#
# Personal space (only you have access):
# HIDRIVE_INCOMING_PATH=/incoming
# HIDRIVE_PROCESSED_PATH=/processed
# HIDRIVE_PATIENTS_DIR_PREFIX=/patients
#
# Advanced: HIDRIVE_USERS_ROOT_PREFIX overrides resolution for relative paths (must start with /users/ or /public/).
# HIDRIVE_USERS_ROOT_PREFIX=/users/example_team_common

# Publiczny URL portalu wyników pacjenta (SMS: placeholder {url} w other.sms.patient_results).
# Dev: http://127.0.0.1:8000  |  Prod: https://<twoja-domena-portalu> (ustaw w .env na VPS, nie commituj).
PATIENT_RESULTS_BASE_URL=http://127.0.0.1:8000
PATIENT_RESULTS_OTP_PEPPER=change-me-secret-pepper

# Nginx prod (docker-compose.prod.yml): hostname bez https:// — server_name i ścieżki certbot/Let's Encrypt.
# NGINX_PUBLIC_HOST=portal.example.com

# CAPTCHA (Cloudflare Turnstile) – portal wyników pacjenta
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
CAPTCHA_VERIFY_SKIP=0

# OpenTelemetry. Puste / brak wpisu = brak eksportu (dev i prod bez profilu observability).
# Prod z `docker compose -f docker-compose.prod.yml --profile observability`: ustaw np.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# (nazwa usługi `otel-collector` w sieci Compose). OTEL_SERVICE_NAME ustawia compose (web / scheduler).

# Grafana (docker-compose.prod.yml --profile observability) — nadpisz domyślne admin/admin:
# GF_SECURITY_ADMIN_PASSWORD=change-me-strong-password
#
# Adres bindu portów observability na hoście (Prometheus, Grafana, …). Domyślnie 127.0.0.1 — bezpieczne na VPS.
# OBSERVABILITY_BIND_ADDR=0.0.0.0
