# W produkcji (ENVIRONMENT=prod) SECRET_KEY jest wymagany – aplikacja nie uruchomi się bez niego.
SECRET_KEY=change-me-in-local-env
SENTRY_DSN=
DB_NAME=cogitomedica
DB_USER=cogito_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# W produkcji ALLOWED_HOSTS musi być ustawione (np. twojadomena.com). Domyślnie puste.
# Dla Docker Compose: dodaj "web", żeby Prometheus mógł scrapować metryki (Host: web:8000).
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Opcjonalnie: dozwolone origins dla CORS (gdy front na innej domenie/porcie).
# W dev bez tej zmiennej używane są localhost:8000, 127.0.0.1:8000, localhost:3000, 127.0.0.1:3000.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Token autoryzacyjny dla endpointu Prometheusa (np. dla /api/v1/observability/metrics)
PROMETHEUS_METRICS_TOKEN=change-me-in-local-env

# SMS (SMSApi smsapi.pl) – portal ergebnisse
SMSAPI_ACCESS_TOKEN=
SMSAPI_USE_MOCK=1
PATIENT_RESULTS_BASE_URL=https://ergebnisse.cogitomedica.pl
PATIENT_RESULTS_OTP_PEPPER=change-me-secret-pepper

# CAPTCHA (Cloudflare Turnstile) – portal ergebnisse
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
CAPTCHA_VERIFY_SKIP=0
