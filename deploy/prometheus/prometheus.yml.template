global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - "/etc/prometheus/alerts.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

scrape_configs:
  - job_name: "cogitomedica_web"
    metrics_path: "/api/v1/observability/metrics"
    authorization:
      type: Bearer
      credentials: "__PROMETHEUS_METRICS_TOKEN__"
    static_configs:
      - targets: ["web:8000"]
