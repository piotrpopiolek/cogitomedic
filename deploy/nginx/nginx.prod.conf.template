# Produkcyjny reverse proxy (Docker). Szablon — przy starcie kontenera nginx podstawia
# __NGINX_PUBLIC_HOST__ z env NGINX_PUBLIC_HOST (docker-compose.prod.yml, .env na VPS).
#
# Certyfikaty: montaż /etc/letsencrypt z hosta (certbot). Ścieżki certów muszą
# odpowiadać hostname w NGINX_PUBLIC_HOST.
#
# Brak bloku upstream { server web:8000; } — resolver Dockera + proxy_pass ze zmienną.

# --- HTTP: ACME (odnowienia certbot --webroot) + przekierowanie na HTTPS ---
server {
    listen 80;
    server_name __NGINX_PUBLIC_HOST__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS ---
server {
    listen 443 ssl http2;
    server_name __NGINX_PUBLIC_HOST__;

    ssl_certificate     /etc/letsencrypt/live/__NGINX_PUBLIC_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__NGINX_PUBLIC_HOST__/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    resolver 127.0.0.11 valid=30s ipv6=off;

    client_max_body_size 250m;
    client_body_timeout 600s;

    location /static/ {
        alias /var/www/static/;
        expires 30d;
        add_header Cache-Control "public";
    }

    # PHI (PDF Befund, podpisy, intake) — nie serwuj /media/ tutaj.
    # Pobrania tylko przez Django (portal OTP, staff API). /media/ → proxy poniżej → 404.

    location / {
        set $cogito_web_upstream web:8000;
        proxy_pass http://$cogito_web_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
